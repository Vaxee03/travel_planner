# Copy this file to .env.local and fill in real values.
# .env.local is gitignored (see .gitignore's *.local rule) — never commit real keys.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Only needed if your Firestore database was created with a custom id
# instead of the default "(default)" one (check the dropdown at the top of
# the Firestore console page).
VITE_FIREBASE_DATABASE_ID=

VITE_GOOGLE_MAPS_API_KEY=
