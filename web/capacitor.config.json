{
  "appId": "kr.tripplanner.app",
  "appName": "여행 플래너",
  "webDir": "dist-native",
  "android": {
    "backgroundColor": "#16181d"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 600,
      "backgroundColor": "#16181d",
      "showSpinner": false
    },
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": [
        "google.com"
      ]
    }
  }
}