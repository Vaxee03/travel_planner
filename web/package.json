{
  "name": "tripplanner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:rules": "npx --yes firebase-tools@14 emulators:exec --only firestore,storage \"node --test tests/\"",
    "dev:emulator": "vite --mode emulator",
    "qa": "node e2e/run-all.mjs",
    "build:native": "vite build --mode native && npm run cap -- sync android",
    "cap": "npx -y -p node@22 node node_modules/@capacitor/cli/bin/capacitor",
    "icons": "node scripts/make-icons.mjs",
    "og": "node scripts/make-og.mjs"
  },
  "dependencies": {
    "@capacitor-firebase/app-check": "^8.5.2",
    "@capacitor-firebase/authentication": "^8.5.2",
    "@capacitor-firebase/messaging": "^8.5.2",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@react-google-maps/api": "^2.20.8",
    "firebase": "^12.19.0",
    "motion": "^13.4.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.3.4",
    "dotenv": "^18.0.1",
    "puppeteer-core": "^23.11.1",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6",
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
